# Application
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Database
# For local dev SQLite/Postgres:
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET=deepsta_super_secret_jwt_access_key_change_in_production_2026
JWT_REFRESH_SECRET=deepsta_super_secret_jwt_refresh_key_change_in_production_2026
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Storage Configuration
# Options: 'local' | 'r2' | 's3'
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads
STORAGE_BASE_URL=http://localhost:5000/uploads

# Cloudflare R2 / S3 (For Production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
